360 0 obj
<</Type/StructElem/E<FEFFD83CDF380020005400650065006A0020201300200041002000430065006C006500620072006100740069006F006E0020006F006600200054007200610064006900740069006F006E002C0020004400650076006F00740069006F006E0020002600200054006F006700650074006800650072006E006500730073>/K[2]/P 100 0 R/S/H1/T<FEFFD83CDF380020005400650065006A0020201300200041002000430065006C006500620072006100740069006F006E0020006F006600200054007200610064006900740069006F006E002C0020004400650076006F00740069006F006E0020002600200054006F006700650074006800650072006E006500730073>/Pg 32 0 R>>
endobj

361 0 obj
<</Type/StructElem/E(Teej is one of Rajasthan\220s most colourful and cherished festivals, celebrating tradition, devotion, family bonds and the arrival of the monsoon. The festival transforms the rainy season into a joyful celebration filled with greenery, music, colourful attire and community gatherings.)/K[3]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

362 0 obj
<</Type/StructElem/E<FEFFD83CDF3F00200048006900730074006F00720079002000260020005300690067006E00690066006900630061006E00630065>/K[4]/P 100 0 R/S/H3/T<FEFFD83CDF3F00200048006900730074006F00720079002000260020005300690067006E00690066006900630061006E00630065>/Pg 32 0 R>>
endobj

363 0 obj
<</Type/StructElem/E(Teej is deeply associated with Goddess Parvati and Lord Shiva. According to Hindu tradition, Goddess Parvati\220s devotion and perseverance ultimately led to her union with Lord Shiva. The festival therefore symbolises love, commitment, strength and marital harmony.)/K[5]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

364 0 obj
<</Type/StructElem/E(In Rajasthan, Hariyali Teej has particular cultural significance. The arrival of the monsoon after the intense summer heat represents renewal, prosperity and new beginnings.)/K[6]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

365 0 obj
<</Type/StructElem/E<FEFFD83DDC830020005400650065006A00200069006E002000520061006A00610073007400680061006E>/K[7]/P 100 0 R/S/H3/T<FEFFD83DDC830020005400650065006A00200069006E002000520061006A00610073007400680061006E>/Pg 32 0 R>>
endobj

366 0 obj
<</Type/StructElem/E(Women traditionally dress in beautiful Leheriya and Bandhani sarees and poshaks, adorn themselves with jewellery, mehendi and colourful bangles, and come together to sing traditional Teej and Saawan songs.)/K[8]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

367 0 obj
<</Type/StructElem/E(Decorated swings \(jhoolas\), folk music and dance create the distinctive festive atmosphere. In Jaipur, the traditional Teej Mata procession has long been one of the festival's most recognisable celebrations, showcasing Rajasthan's royal and cultural heritage.)/K[9]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

368 0 obj
<</Type/StructElem/E<FEFFD83CDF4300200046006F006F0064002C002000460061006D0069006C007900200026002000460065007300740069007600690074006900650073>/K[10]/P 100 0 R/S/H3/T<FEFFD83CDF4300200046006F006F0064002C002000460061006D0069006C007900200026002000460065007300740069007600690074006900650073>/Pg 32 0 R>>
endobj

369 0 obj
<</Type/StructElem/E(Teej celebrations are also known for festive delicacies such as Ghevar, Feeni and traditional Rajasthani dishes. Families visit one another, exchange sweets and gifts, and celebrate with music, dance and community activities.)/K[11]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

370 0 obj
<</Type/StructElem/E<FEFFD83CDDEED83CDDF3002000460072006F006D002000520061006A00610073007400680061006E00200074006F0020004D0065006C0062006F00750072006E00650020D83CDDE6D83CDDFA>/K[12]/P 100 0 R/S/H3/T<FEFFD83CDDEED83CDDF3002000460072006F006D002000520061006A00610073007400680061006E00200074006F0020004D0065006C0062006F00750072006E00650020D83CDDE6D83CDDFA>/Pg 32 0 R>>
endobj

371 0 obj
<</Type/StructElem/E(For Rajasthanis living overseas, Teej has an even deeper meaning. It provides an opportunity to introduce our children and youth to the traditions, music, attire, food and values of Rajasthan, while bringing generations together.)/K[13]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

372 0 obj
<</Type/StructElem/E(Through RAJKOV Teej Utsav 2026, we celebrate not only a festival, but also the heritage that connects us to our roots.)/K[14]/P 100 0 R/S/P/Pg 32 0 R>>
endobj

